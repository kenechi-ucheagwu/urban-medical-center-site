# Copy to .env.local and fill in. Never commit real values.

# NPI numbers for the schema.org JSON-LD in src/app/layout.tsx.
# Leave a value empty and its identifier block is left out.
NEXT_PUBLIC_CLINIC_NPI=
NEXT_PUBLIC_PHYSICIAN_NPI=

# Google service account key (JSON) for the contact form's Gmail API sender.
GOOGLE_SERVICE_ACCOUNT_KEY=
